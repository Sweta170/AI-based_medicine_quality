# ─── Pharmadesk Server Environment Variables ───
# Copy this file to .env and fill in real values

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pharmadesk?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<generate-a-64-char-random-string>
JWT_REFRESH_SECRET=<generate-a-64-char-random-string>
CLIENT_URL=https://pharmadesk.vercel.app

# Optional: SMTP for real email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: Twilio for real SMS reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
